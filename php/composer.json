{
    "name": "mooeypoo/funcystr",
    "description": "A lightweight PHP library for processing strings with embedded functions.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Moriel Schottlender",
            "email": "mooeypoo@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "FuncyStr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FuncyStr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@validate",
            "php -v"
        ],
        "validate": "composer validate --strict",
        "build": [
            "@validate",
            "php -r \"echo 'Building FuncyStr PHP...'.PHP_EOL;\"",
            "bash scripts/build.sh"
        ]
    },
    "config": {
        "sort-packages": true
    }
}

